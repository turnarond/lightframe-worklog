{
  "name": "lightframe-worklog",
  "version": "2.5.1",
  "description": "桌面任务与日报周报工具",
  "main": "main.js",
  "author": "Lightframe",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test src/*.test.js server-lite/*.test.js",
    "sync:server": "node server-lite/server.js",
    "pack:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/pack-sync-server.ps1",
    "icon": "node tools/genicon.js",
    "smoke": "node tools/smoke-ui.js",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "release": "electron-builder --win nsis --publish=always"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/karla": "^5.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.lightframe.worklog",
    "productName": "光影工作志",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "quick-add.html",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "光影工作志"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "turnarond",
        "repo": "lightframe-worklog",
        "private": false
      }
    ]
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.11",
    "markdown-it": "^15.0.3"
  }
}
