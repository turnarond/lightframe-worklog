{
  "name": "lightframe-worklog",
  "version": "2.12.0",
  "description": "桌面任务与日报周报工具",
  "main": "main.js",
  "author": "Lightframe",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test src/*.test.js server-lite/*.test.js",
    "test:release": "node --test scripts/*.test.js tools/*-lib.test.js tools/verify-update.test.js",
    "sync:server": "node server-lite/server.js",
    "pack:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/pack-sync-server.ps1",
    "fetch:cloudflared": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/fetch-cloudflared.ps1",
    "deploy:ssh": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/deploy-ssh.ps1",
    "verify:lan": "node tools/verify-lan.js",
    "verify:update": "node tools/verify-update.js",
    "icon": "node tools/genicon.js",
    "smoke": "node tools/smoke-ui.js",
    "smoke:boot": "node tools/smoke-boot.js",
    "dist": "electron-builder --win nsis",
    "pack:dir": "electron-builder --win dir",
    "dist:portable": "electron-builder --win portable",
    "release": "electron-builder --win nsis --publish=always"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/karla": "^5.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.lightframe.worklog",
    "productName": "光影工作志",
    "afterPack": "./scripts/after-pack-slim.js",
    "electronLanguages": [
      "zh-CN",
      "zh-TW",
      "en-US"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "quick-add.html",
      "src/**/*",
      "!src/**/*.test.js",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "光影工作志"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "turnarond",
        "repo": "lightframe-worklog",
        "private": false
      }
    ]
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "electron-updater": "^6.8.11",
    "markdown-it": "^15.0.3"
  }
}
